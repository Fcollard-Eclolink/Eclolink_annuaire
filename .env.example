# ── Configuration production (docker-compose.prod.yml) ────────────
# Copier en `.env` et remplir avec des valeurs réelles. NE PAS commiter .env.

# PostgreSQL (service db)
POSTGRES_USER=eclolink
POSTGRES_PASSWORD=change-moi-mot-de-passe-fort
POSTGRES_DB=eclolink

# URL de connexion utilisée par l'app et les migrations.
# L'hôte est `db` (nom du service compose), pas localhost.
NUXT_DATABASE_URL=postgres://eclolink:change-moi-mot-de-passe-fort@db:5432/eclolink

# Secret de session (pepper). Générer p.ex. avec : openssl rand -base64 48
NUXT_SESSION_SECRET=change-moi-secret-aleatoire-long
