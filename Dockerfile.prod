# ── Build de production multi-stage ───────────────────────────────
# Cible `runner` : image slim qui lance le serveur Nitro compilé.
# Cible `source` : image avec sources + node_modules (devDeps) — utilisée
#                  pour appliquer les migrations (npm run db:migrate).

FROM node:22-alpine AS base
WORKDIR /app

# Dépendances (avec devDeps : nécessaires au build Nuxt et à drizzle-kit)
FROM base AS deps
COPY app/package.json app/package-lock.json ./
RUN npm ci

# Sources complètes
FROM deps AS source
COPY app/ .

# Build Nuxt → .output autonome
FROM source AS build
RUN npm run build

# Image finale : uniquement le serveur compilé
FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app/.output ./.output
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
